[Unit]
Description=cnpq
After=network.target
[Service]
User=root
Group=root
WorkingDirectory=/home/ubuntu/cnpq
ExecStart=/home/ubuntu/cnpq/venv/bin/gunicorn run:app -b 127.0.0.1:5000
Environment="PATH=/home/ubuntu/cnpq/venv/bin"
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

[Install]
WantedBy=multi-user.target